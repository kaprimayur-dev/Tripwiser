# Environment Configuration Example
PROJECT_NAME=TripWiser
ENVIRONMENT=development

# Database Settings
POSTGRES_DB=tripwiser_db
POSTGRES_USER=tripwiser
POSTGRES_PASSWORD=tripwiser
DATABASE_URL=postgresql+asyncpg://tripwiser:tripwiser@localhost:5432/tripwiser_db

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Provider Settings
AVAILABILITY_PROVIDER=mock
CHART_VACANCY_PROVIDER=mock
