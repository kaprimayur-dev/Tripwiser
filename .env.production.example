# ==============================================================================
# TripWiser Production Environment Template (.env.production.example)
# Use this file as a reference for production deployment variables.
# NEVER commit actual passwords, private connection strings, or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend (Vercel Project Environment Variables)
# ------------------------------------------------------------------------------
# Public URL of the deployed FastAPI backend (e.g., on Railway)
NEXT_PUBLIC_API_URL=https://<your-backend-service>.up.railway.app

# ------------------------------------------------------------------------------
# 2. Backend (Railway FastAPI Web Service Environment Variables)
# ------------------------------------------------------------------------------
PROJECT_NAME=TripWiser API
VERSION=0.1.0
ENVIRONMENT=production

# Database Connection (auto-normalized to postgresql+asyncpg:// and safe SSL)
# On Railway: use internal DNS if co-located: postgresql+asyncpg://<user>:<password>@postgres.railway.internal:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://<postgres-user>:<postgres-password>@<postgres-host>:5432/<postgres-db>?ssl=require

# Redis Connection (internal Railway DNS or managed Redis URL)
REDIS_URL=redis://<redis-host>:6379/0

# Allowed CORS Origins (JSON array string matching production frontend)
BACKEND_CORS_ORIGINS=["https://<your-frontend>.vercel.app","http://localhost:3000"]

# Providers & Operational Constraints
AVAILABILITY_PROVIDER=mock
CHART_VACANCY_PROVIDER=mock
MIN_TRANSFER_MINUTES=30
MAX_LAYOVER_MINUTES=360

# ------------------------------------------------------------------------------
# 3. Database (Railway PostGIS Service Environment Variables)
# ------------------------------------------------------------------------------
# Docker Image: postgis/postgis:15-3.3-alpine
# Persistent Volume: /var/lib/postgresql/data
POSTGRES_DB=tripwiser_db
POSTGRES_USER=tripwiser
POSTGRES_PASSWORD=<strong_random_database_password>

